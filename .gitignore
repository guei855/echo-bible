# Large generated/downloaded resources are published separately as release assets.
/release_resources/**/*.db
/bible_builder/sources/dictionary/vigouroux/cache/
/bible_builder/backups/
/bible_builder/sources/dictionary/vigouroux/*.djvu
/bible_builder/sources/concordance_bible/*.zip

# Local heavyweight databases; never upload bible.db to GitHub.
/assets/database/bible.db
/assets/database/strong.db
/assets/database/cross_references.db

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
